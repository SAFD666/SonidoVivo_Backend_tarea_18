{
  "info": {
    "name": "Sonido Vivo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden (Run collection). Cambia baseUrl por http://IP_PUBLICA_EC2:8080 y demoPassword por el valor de DEMO_PASSWORD. Cuentas: admin@sonidovivo.cl, vendedor@sonidovivo.cl, cliente@correo.cl. Roles y estados viajan con el texto del frontend (Administrador, Vendedor, Cliente / En preparación, Enviado...)."
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registrar cliente nuevo (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"correo\": \"ana.perez{{$randomInt}}@correo.cl\",\n  \"password\": \"clave123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Rol asignado por el servidor = Cliente', () => pm.expect(pm.response.json().rol).to.eql('Cliente'));",
                  "pm.test('No devuelve contraseña ni hash', () => { const u = pm.response.json(); pm.expect(u).to.not.have.property('password'); pm.expect(u).to.not.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
